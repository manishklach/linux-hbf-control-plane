diff --git a/tools/hbftrace/kvcache_monitor.py b/tools/hbftrace/kvcache_monitor.py
new file mode 100755
index 000000000..12fd55e94
--- /dev/null
+++ b/tools/hbftrace/kvcache_monitor.py
@@ -0,0 +1,211 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0
+"""
+kvcache_monitor.py — Watch an LLM inference process and submit HBF hints
+for KV-cache pages on suboptimal NUMA/CXL nodes.
+
+Usage:
+  # Monitor a running vLLM or llama.cpp process:
+  python3 kvcache_monitor.py --pid 1234 --interval 2
+
+  # Dry-run (print what would be submitted without actually doing it):
+  python3 kvcache_monitor.py --pid 1234 --dry-run
+
+  # Specify target NUMA node (default: nearest CPU node to CXL memory):
+  python3 kvcache_monitor.py --pid 1234 --target-node 0
+
+Requires:
+  - Linux with /proc/PID/numa_maps
+  - hbfctl in PATH (or HBFCTL env var pointing to it)
+  - Root or CAP_SYS_ADMIN for /proc/PID/numa_maps
+"""
+import argparse
+import os
+import re
+import subprocess
+import sys
+import time
+
+
+def find_hbfctl():
+    env = os.environ.get("HBFCTL")
+    if env:
+        return env
+    for path in ["/usr/local/bin/hbfctl", "/usr/bin/hbfctl", "./hbfctl"]:
+        if os.path.isfile(path) and os.access(path, os.X_OK):
+            return path
+    return "hbfctl"
+
+
+def read_numa_maps(pid):
+    path = f"/proc/{pid}/numa_maps"
+    try:
+        with open(path) as f:
+            return f.readlines()
+    except FileNotFoundError:
+        return None
+    except PermissionError:
+        print(f"ERROR: Permission denied reading {path} (try as root)", file=sys.stderr)
+        sys.exit(1)
+
+
+def parse_numa_maps(lines, preferred_node):
+    candidates = []
+    for line in lines:
+        parts = line.split()
+        if len(parts) < 2:
+            continue
+        addr_range = parts[0]
+        if "-" not in addr_range:
+            continue
+        start_str, end_str = addr_range.split("-", 1)
+        try:
+            start = int(start_str, 16)
+            end = int(end_str, 16)
+        except ValueError:
+            continue
+
+        if end - start > (512 << 20):
+            continue
+
+        policy = None
+        node_pages = {}
+        for token in parts[1:]:
+            if token.startswith("policy="):
+                policy = token[7:]
+            elif re.match(r'^N\d+=\d+$', token):
+                nid_str, count_str = token.split("=")
+                nid = int(nid_str[1:])
+                count = int(count_str)
+                if count > 0:
+                    node_pages[nid] = count
+
+        if not policy or not node_pages:
+            continue
+
+        pages_on_preferred = node_pages.get(preferred_node, 0)
+        total_pages = sum(node_pages.values())
+        if total_pages == 0:
+            continue
+
+        ratio = pages_on_preferred / total_pages
+        if ratio < 0.5:
+            candidates.append((start, end, start, end - start, policy, node_pages))
+
+    return candidates
+
+
+def submit_hint(hbfctl, start, length, op, target_nid, dry_run):
+    cmd = [hbfctl, "submit", hex(start), str(length),
+           "-o", str(op), "-n", str(target_nid)]
+    if dry_run:
+        print(f"  (dry-run) {' '.join(cmd)}")
+        return True
+    try:
+        result = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
+        if result.returncode == 0:
+            return True
+        else:
+            print(f"  submit failed: {result.stderr.strip()}", file=sys.stderr)
+            return False
+    except FileNotFoundError:
+        print(f"ERROR: {hbfctl} not found. Install hbfctl or set HBFCTL env var.",
+              file=sys.stderr)
+        sys.exit(1)
+    except subprocess.TimeoutExpired:
+        print("  submit timed out", file=sys.stderr)
+        return False
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description="Monitor LLM KV-cache and submit HBF migration hints")
+    parser.add_argument("--pid", type=int, required=True,
+                        help="PID of the LLM process to monitor")
+    parser.add_argument("--interval", type=float, default=2.0,
+                        help="Polling interval in seconds (default: 2.0)")
+    parser.add_argument("--target-node", type=int, default=None,
+                        help="Target NUMA node for promotion (default: auto-detect)")
+    parser.add_argument("--min-bytes", type=int, default=4096,
+                        help="Minimum range size in bytes to hint (default: 4096)")
+    parser.add_argument("--dry-run", action="store_true",
+                        help="Print hints without submitting")
+    parser.add_argument("--op", type=int, default=2,
+                        choices=[1, 2, 3, 4],
+                        help="HBF operation: 1=prefetch, 2=promote, 3=demote, 4=release")
+    args = parser.parse_args()
+
+    hbfctl = find_hbfctl()
+
+    if not os.path.isdir(f"/proc/{args.pid}"):
+        print(f"ERROR: Process {args.pid} not running", file=sys.stderr)
+        sys.exit(1)
+
+    if args.target_node is None:
+        try:
+            with open(f"/proc/{args.pid}/status") as f:
+                for line in f:
+                    if line.startswith("Mems_allowed_list:"):
+                        mems = line.strip().split(":")[1].strip()
+                        nodes = []
+                        for part in mems.split(","):
+                            if "-" in part:
+                                a, b = part.split("-")
+                                nodes.extend(range(int(a), int(b) + 1))
+                            else:
+                                nodes.append(int(part))
+                        if nodes:
+                            args.target_node = nodes[0]
+                            break
+        except Exception:
+            pass
+
+        if args.target_node is None:
+            args.target_node = 0
+
+    print(f"HBF KV-cache Monitor")
+    print(f"  PID:          {args.pid}")
+    print(f"  Target node:  {args.target_node}")
+    print(f"  Interval:     {args.interval}s")
+    print(f"  Operation:    {args.op}")
+    print(f"  hbfctl:       {hbfctl}")
+    if args.dry_run:
+        print(f"  DRY RUN: no hints will be submitted")
+    print()
+
+    iteration = 0
+    while True:
+        lines = read_numa_maps(args.pid)
+        if lines is None:
+            print(f"Process {args.pid} has exited.")
+            break
+
+        candidates = parse_numa_maps(lines, args.target_node)
+        total_misplaced = sum((end - start) for _, _, start, end, _, _ in candidates)
+        total_pages = sum(
+            sum(count for _, count in pages.items())
+            for _, _, _, _, _, pages in candidates
+        )
+
+        print(f"[{iteration}] Scanned {len(lines)} VMA regions, "
+              f"{len(candidates)} mis-placed ranges "
+              f"({total_misplaced >> 20} MB on wrong node)", end="")
+
+        hints_submitted = 0
+        for start, end, actual_start, actual_len, policy, pages in candidates:
+            if actual_len < args.min_bytes:
+                continue
+            if hints_submitted >= 8:
+                break
+            if submit_hint(hbfctl, actual_start, actual_len,
+                          args.op, args.target_node, args.dry_run):
+                hints_submitted += 1
+
+        print(f", {hints_submitted} hints submitted")
+
+        iteration += 1
+        time.sleep(args.interval)
+
+
+if __name__ == "__main__":
+    main()
-- 
