index 000000000..0d33389e4
--- /dev/null
+++ b/mm/hbf/hbf_cxl.c
@@ -0,0 +1,185 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/mm.h>
+#include <linux/mmzone.h>
+#include <linux/migrate.h>
+#include <linux/sched/mm.h>
+#include <linux/gfp.h>
+#include <linux/pagemap.h>
+#include <linux/err.h>
+#include <linux/nodemask.h>
+#include <linux/seq_file.h>
+#include <linux/debugfs.h>
+#include "hbf_backend.h"
+#include "hbf_cxl.h"
+#include "hbf_debugfs.h"
+
+static struct dentry *cxl_debugfs_dir;
+
+/* Detect CXL nodes: memory-only nodes with no CPUs */
+static bool is_cxl_node(int nid)
+{
+	if (!node_online(nid))
+		return false;
+	if (!node_state(nid, N_MEMORY))
+		return false;
+	if (node_state(nid, N_CPU))
+		return false;
+	return true;
+}
+
+static bool cxl_supports_target(int nid)
+{
+	return is_cxl_node(nid);
+}
+
+static int cxl_query_range(struct mm_struct *mm, unsigned long start,
+			   unsigned long len, int *src_nid)
+{
+	return -EOPNOTSUPP;
+}
+
+static int cxl_migrate_range(struct mm_struct *mm, unsigned long start,
+			     unsigned long len, int target_nid)
+{
+	unsigned long addr;
+	int ret;
+	unsigned int nr_succeeded;
+	LIST_HEAD(folio_list);
+
+	if (!mm)
+		return -ESRCH;
+
+	addr = start;
+	while (addr < start + len) {
+		struct page *page;
+		struct folio *folio;
+		int nr_pinned;
+		int nr_folio_pages;
+
+		nr_pinned = get_user_pages_fast(addr, 1, FOLL_GET, &page);
+		if (nr_pinned <= 0) {
+			addr += PAGE_SIZE;
+			continue;
+		}
+
+		folio = page_folio(page);
+		if (folio_nid(folio) == target_nid) {
+			put_page(page);
+			addr += PAGE_SIZE;
+			continue;
+		}
+
+		if (!isolate_folio_to_list(folio, &folio_list)) {
+			put_page(page);
+			addr += PAGE_SIZE;
+			continue;
+		}
+
+		nr_folio_pages = folio_nr_pages(folio);
+		put_page(page);
+		addr += nr_folio_pages * PAGE_SIZE;
+	}
+
+	if (list_empty(&folio_list))
+		return 0;
+
+	nr_succeeded = 0;
+	ret = migrate_pages(&folio_list, alloc_migration_target, NULL,
+			    (unsigned long)target_nid, MIGRATE_SYNC,
+			    MR_NUMA_MISPLACED, &nr_succeeded);
+	if (ret < 0) {
+		if (!list_empty(&folio_list))
+			putback_movable_pages(&folio_list);
+		return ret;
+	}
+
+	if (!list_empty(&folio_list))
+		putback_movable_pages(&folio_list);
+
+	return nr_succeeded;
+}
+
+static int cxl_promote_range(struct mm_struct *mm, unsigned long start,
+			     unsigned long len, int target_nid)
+{
+	return cxl_migrate_range(mm, start, len, target_nid);
+}
+
+static int cxl_demote_range(struct mm_struct *mm, unsigned long start,
+			    unsigned long len, int target_nid)
+{
+	return cxl_migrate_range(mm, start, len, target_nid);
+}
+
+static int cxl_prefetch_range(struct mm_struct *mm, unsigned long start,
+			      unsigned long len, int target_nid)
+{
+	return cxl_migrate_range(mm, start, len, target_nid);
+}
+
+static int cxl_release_range(struct mm_struct *mm, unsigned long start,
+			     unsigned long len)
+{
+	return 0;
+}
+
+static const struct hbf_backend_ops cxl_backend_ops = {
+	.name		= "cxl",
+	.query_range	= cxl_query_range,
+	.prefetch_range	= cxl_prefetch_range,
+	.promote_range	= cxl_promote_range,
+	.demote_range	= cxl_demote_range,
+	.release_range	= cxl_release_range,
+	.supports_target	= cxl_supports_target,
+};
+
+static int cxl_nodes_show(struct seq_file *m, void *v)
+{
+	int nid;
+
+	seq_puts(m, "CXL memory nodes:\n");
+	for_each_node_state(nid, N_MEMORY) {
+		if (is_cxl_node(nid)) {
+			unsigned long total = 0;
+			struct zone *zone;
+			enum zone_type z;
+
+	for (z = 0; z < MAX_NR_ZONES; z++) {
+			zone = &NODE_DATA(nid)->node_zones[z];
+			total += zone->present_pages;
+		}
+
+			seq_printf(m, "  node %d: %lu MB\n",
+				   nid, (total * PAGE_SIZE) >> 20);
+		}
+	}
+	return 0;
+}
+
+DEFINE_SHOW_ATTRIBUTE(cxl_nodes);
+
+int hbf_cxl_register(void)
+{
+	int ret;
+	struct dentry *root;
+
+	ret = hbf_register_backend(&cxl_backend_ops);
+	if (ret)
+		return ret;
+
+	root = hbf_get_debugfs_root();
+	if (root) {
+		cxl_debugfs_dir = debugfs_create_dir("cxl", root);
+		if (!IS_ERR(cxl_debugfs_dir))
+			debugfs_create_file("nodes", 0444, cxl_debugfs_dir,
+					   NULL, &cxl_nodes_fops);
+	}
+
+	return 0;
+}
+
+void hbf_cxl_unregister(void)
+{
+	hbf_unregister_backend(&cxl_backend_ops);
+	debugfs_remove_recursive(cxl_debugfs_dir);
+}
