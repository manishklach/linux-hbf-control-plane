+++ b/mm/hbf/hbf_numa.h
@@ -0,0 +1,8 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _HBF_NUMA_H
+#define _HBF_NUMA_H
+
+int hbf_numa_register(void);
+void hbf_numa_unregister(void);
+
+#endif /* _HBF_NUMA_H */
