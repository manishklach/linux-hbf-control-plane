diff --git a/mm/hbf/hbf_debugfs.c b/mm/hbf/hbf_debugfs.c
new file mode 100644
index 000000000..8c506db25
--- /dev/null
+++ b/mm/hbf/hbf_debugfs.c
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/debugfs.h>
+#include <linux/seq_file.h>
+#include <linux/atomic.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include "hbf_types.h"
+#include "hbf_backend.h"
+#include "hbf_request.h"
+#include "hbf_debugfs.h"
+
+static struct dentry *hbf_debugfs_root;
+
+struct hbf_stats {
+	atomic64_t		total_submitted;
+	atomic64_t		total_accepted;
+	atomic64_t		total_rejected;
+	atomic64_t		total_completed;
+	atomic64_t		total_failed;
+	atomic64_t		total_bytes_moved;
+	atomic64_t		total_deadline_misses;
+	atomic64_t		total_cancelled;
+};
+
+static struct hbf_stats hbf_stats;
+
+static __maybe_unused void hbf_stat_inc(atomic64_t *counter)
+{
+	atomic64_inc(counter);
+}
+
+static __maybe_unused void hbf_stat_add(atomic64_t *counter, u64 val)
+{
+	atomic64_add(val, counter);
+}
+
+static int hbf_stats_show(struct seq_file *m, void *v)
+{
+	seq_printf(m, "submitted\t\t%llu\n",
+		   atomic64_read(&hbf_stats.total_submitted));
+	seq_printf(m, "accepted\t\t%llu\n",
+		   atomic64_read(&hbf_stats.total_accepted));
+	seq_printf(m, "rejected\t\t%llu\n",
+		   atomic64_read(&hbf_stats.total_rejected));
+	seq_printf(m, "completed\t\t%llu\n",
+		   atomic64_read(&hbf_stats.total_completed));
+	seq_printf(m, "failed\t\t\t%llu\n",
+		   atomic64_read(&hbf_stats.total_failed));
+	seq_printf(m, "bytes_moved\t\t%llu\n",
+		   atomic64_read(&hbf_stats.total_bytes_moved));
+	seq_printf(m, "deadline_misses\t\t%llu\n",
+		   atomic64_read(&hbf_stats.total_deadline_misses));
+	seq_printf(m, "cancelled\t\t%llu\n",
+		   atomic64_read(&hbf_stats.total_cancelled));
+	return 0;
+}
+
+DEFINE_SHOW_ATTRIBUTE(hbf_stats);
+
+static int hbf_backends_show(struct seq_file *m, void *v)
+{
+	seq_puts(m, "backend\t\tquery\tprefetch\tpromote\tdemote\trelease\n");
+	return 0;
+}
+
+DEFINE_SHOW_ATTRIBUTE(hbf_backends);
+
+static int hbf_reset_stats_set(void *data, u64 val)
+{
+	if (val == 1) {
+		atomic64_set(&hbf_stats.total_submitted, 0);
+		atomic64_set(&hbf_stats.total_accepted, 0);
+		atomic64_set(&hbf_stats.total_rejected, 0);
+		atomic64_set(&hbf_stats.total_completed, 0);
+		atomic64_set(&hbf_stats.total_failed, 0);
+		atomic64_set(&hbf_stats.total_bytes_moved, 0);
+		atomic64_set(&hbf_stats.total_deadline_misses, 0);
+		atomic64_set(&hbf_stats.total_cancelled, 0);
+	}
+	return 0;
+}
+
+DEFINE_DEBUGFS_ATTRIBUTE(hbf_reset_stats_fops, NULL, hbf_reset_stats_set, "%llu");
+
+int hbf_init_debugfs(void)
+{
+	hbf_debugfs_root = debugfs_create_dir("hbf", NULL);
+	if (IS_ERR(hbf_debugfs_root))
+		return PTR_ERR(hbf_debugfs_root);
+
+	debugfs_create_file("stats", 0444, hbf_debugfs_root, NULL,
+			    &hbf_stats_fops);
+	debugfs_create_file("backends", 0444, hbf_debugfs_root, NULL,
+			    &hbf_backends_fops);
+	debugfs_create_file("reset_stats", 0200, hbf_debugfs_root, NULL,
+			    &hbf_reset_stats_fops);
+	return 0;
+}
+
+void hbf_exit_debugfs(void)
+{
+	debugfs_remove_recursive(hbf_debugfs_root);
+}
