+		__entry->pid = pid;
+		__entry->tgid = tgid;
+	),
+
+	TP_printk("addr=%lx pid=%d tgid=%d",
+		  __entry->addr, __entry->pid, __entry->tgid)
+);
+
+TRACE_EVENT(hbf_queue_full,
+
+	TP_PROTO(u64 request_id, int queue_depth),
+
+	TP_ARGS(request_id, queue_depth),
+
+	TP_STRUCT__entry(
+		__field(u64, request_id)
+		__field(int, queue_depth)
+	),
+
+	TP_fast_assign(
+		__entry->request_id = request_id;
+		__entry->queue_depth = queue_depth;
+	),
+
+	TP_printk("req=%llu depth=%d", __entry->request_id, __entry->queue_depth)
+);
+
