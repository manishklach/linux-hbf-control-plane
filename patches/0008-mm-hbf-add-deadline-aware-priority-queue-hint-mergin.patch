diff --git a/mm/hbf/hbf_request.c b/mm/hbf/hbf_request.c
index 2038c2093..95ded6516 100644
--- a/mm/hbf/hbf_request.c
+++ b/mm/hbf/hbf_request.c
@@ -9,9 +9,11 @@
 #include <linux/atomic.h>
 #include <linux/mm.h>
 #include <linux/err.h>
+#include <linux/minmax.h>
 #include "hbf_types.h"
 #include "hbf_request.h"
