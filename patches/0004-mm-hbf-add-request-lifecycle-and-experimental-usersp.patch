diff --git a/mm/hbf/Kconfig b/mm/hbf/Kconfig
new file mode 100644
index 000000000..a766c4309
--- /dev/null
+++ b/mm/hbf/Kconfig
@@ -0,0 +1,14 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+config HBF_CONTROL_PLANE
+	tristate "HBF Memory Tier Control Plane"
+	depends on MMU
+	depends on MIGRATION
+	help
+	  Provides a runtime-guided memory-tier hint interface for AI
+	  inference workloads.  Userspace processes can submit asynchronous
+	  prefetch, promote, and demote hints to move memory pages between
+	  NUMA nodes (as proxies for hot/warm memory tiers) before demand
+	  access.
+
+	  If unsure, say N.
