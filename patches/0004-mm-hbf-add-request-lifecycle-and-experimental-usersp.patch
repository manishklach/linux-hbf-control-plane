diff --git a/mm/hbf/hbf_main.c b/mm/hbf/hbf_main.c
new file mode 100644
index 000000000..b4f6d0241
--- /dev/null
+++ b/mm/hbf/hbf_main.c
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/module.h>
+#include <linux/fs.h>
+#include <linux/miscdevice.h>
+#include "hbf_request.h"
+#include "hbf_debugfs.h"
+#include "hbf_backend.h"
+#include "hbf_ioctl.h"
+#include "hbf_numa.h"
+
+#define HBF_DEVICE_NAME	"hbfctl"
+
+static const struct file_operations hbf_fops = {
+	.owner		= THIS_MODULE,
+	.unlocked_ioctl	= hbf_ioctl,
+	.llseek		= noop_llseek,
+};
+
+static struct miscdevice hbf_miscdev = {
+	.minor	= MISC_DYNAMIC_MINOR,
+	.name	= HBF_DEVICE_NAME,
+	.fops	= &hbf_fops,
+	.mode	= 0600,
+};
+
+
+
+static int __init hbf_init(void)
+{
+	int ret;
+
+	ret = hbf_init_request_table();
+	if (ret)
+		return ret;
+
+	ret = hbf_init_debugfs();
+	if (ret)
+		goto err_debugfs;
+
+	ret = misc_register(&hbf_miscdev);
+	if (ret)
+		goto err_misc;
+
+	ret = hbf_numa_register();
+	if (ret)
+		pr_warn("hbf: NUMA backend not available\n");
+
+	pr_info("hbf: control plane initialized, /dev/%s created\n",
+		HBF_DEVICE_NAME);
+	return 0;
+
+err_misc:
+	hbf_exit_debugfs();
+err_debugfs:
+	hbf_exit_request_table();
+	return ret;
+}
+
+static void __exit hbf_exit(void)
+{
+	hbf_numa_unregister();
+	misc_deregister(&hbf_miscdev);
+	hbf_exit_debugfs();
+	hbf_exit_request_table();
+	pr_info("hbf: control plane unloaded\n");
+}
+
+module_init(hbf_init);
+module_exit(hbf_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("Manish KL");
+MODULE_DESCRIPTION("HBF Memory Tier Control Plane");
diff --git a/mm/hbf/hbf_request.c b/mm/hbf/hbf_request.c
new file mode 100644
index 000000000..2038c2093
--- /dev/null
+++ b/mm/hbf/hbf_request.c
@@ -0,0 +1,374 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/slab.h>
+#include <linux/sched.h>
+#include <linux/sched/mm.h>
+#include <linux/workqueue.h>
+#include <linux/spinlock.h>
+#include <linux/hashtable.h>
+#include <linux/ktime.h>
+#include <linux/atomic.h>
+#include <linux/mm.h>
+#include <linux/err.h>
+#include "hbf_types.h"
+#include "hbf_request.h"
+#include "hbf_backend.h"
+#include <trace/events/hbf.h>
+
+static DEFINE_HASHTABLE(hbf_request_table, 8);
+static DEFINE_SPINLOCK(hbf_request_lock);
+static atomic64_t hbf_next_id = ATOMIC64_INIT(1);
+static atomic_t hbf_inflight = ATOMIC_INIT(0);
+
+static LIST_HEAD(hbf_queue);
+static DEFINE_SPINLOCK(hbf_queue_lock);
+static struct work_struct hbf_worker;
+
+static u64 hbf_alloc_id(void)
+{
+	return atomic64_inc_return(&hbf_next_id);
+}
+
+struct hbf_request *hbf_request_alloc(struct mm_struct *mm,
+				      const struct mm_tier_range_hint *hint,
+				      u64 user_tag)
+{
+	struct hbf_request *req;
+
+	req = kzalloc(sizeof(*req), GFP_KERNEL);
+	if (!req)
+		return ERR_PTR(-ENOMEM);
+
+	req->request_id = hbf_alloc_id();
+	req->mm = mm;
+	mmgrab(mm);
+	if (!req->mm) {
+		kfree(req);
+		return ERR_PTR(-ESRCH);
+	}
+	req->start = hint->start;
+	req->len = hint->len;
+	req->op = hint->op;
+	req->target_nid = hint->target_nid;
+	req->deadline_ns = hint->deadline_ns;
+	req->user_tag = user_tag;
+
+	atomic_set(&req->state, HBF_REQ_SUBMITTED);
+	req->submit_ns = ktime_get_ns();
+	req->pages_requested = hint->len >> PAGE_SHIFT;
+
+	kref_init(&req->refcount);
+	INIT_LIST_HEAD(&req->queue_node);
+	INIT_HLIST_NODE(&req->hlist_node);
+
+	return req;
+}
+
+static void hbf_request_free(struct kref *kref)
+{
+	struct hbf_request *req = container_of(kref, struct hbf_request, refcount);
+
+	if (req->mm)
+		mmdrop(req->mm);
+	kfree_rcu(req, rcu);
+}
+
+void hbf_request_get(struct hbf_request *req)
+{
+	kref_get(&req->refcount);
+}
+
+void hbf_request_put(struct hbf_request *req)
+{
+	kref_put(&req->refcount, hbf_request_free);
+}
+
+static void hbf_add_to_table(struct hbf_request *req)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&hbf_request_lock, flags);
+	hash_add(hbf_request_table, &req->hlist_node, req->request_id);
+	spin_unlock_irqrestore(&hbf_request_lock, flags);
+}
+
+static void hbf_del_from_table(struct hbf_request *req)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&hbf_request_lock, flags);
+	hash_del(&req->hlist_node);
+	spin_unlock_irqrestore(&hbf_request_lock, flags);
+}
+
+static int hbf_validate(struct hbf_request *req)
+{
+	struct mm_struct *mm = req->mm;
+	struct vm_area_struct *vma;
+	unsigned long end;
+	int ret = 0;
+
+	if (!mm)
+		return -ESRCH;
+
+	if (req->len == 0 || req->len > HBF_MAX_BYTES_PER_REQUEST)
+		return -EINVAL;
+
+	if (check_add_overflow(req->start, req->len, &end))
+		return -EOVERFLOW;
+
+	mmap_read_lock(mm);
+	vma = find_vma_intersection(mm, req->start, end);
+	if (!vma) {
+		ret = -EFAULT;
+		goto out;
+	}
+
+	if (vma->vm_start > req->start ||
+	    vma->vm_end < end) {
+		ret = -EFAULT;
+		goto out;
+	}
+
+	if (vma->vm_flags & (VM_IO | VM_PFNMAP)) {
+		ret = -EACCES;
+		goto out;
+	}
+
+out:
+	mmap_read_unlock(mm);
+	return ret;
+}
+
+static void hbf_execute_request(struct hbf_request *req)
+{
+	const struct hbf_backend_ops *backend;
+	int ret;
+	u64 now;
+
+	now = ktime_get_ns();
+	req->start_ns = now;
+
+	atomic_set(&req->state, HBF_REQ_RUNNING);
+
+	if (req->deadline_ns && now > req->deadline_ns) {
+		atomic_set(&req->state, HBF_REQ_MISSED_DEADLINE);
+		trace_hbf_deadline_miss(req->request_id, now - req->deadline_ns);
+		goto out;
+	}
+
+	backend = hbf_select_backend(req->target_nid);
+	if (!backend) {
+		atomic_set(&req->state, HBF_REQ_BACKEND_FAILURE);
+		goto out;
+	}
+
+	switch (req->op) {
+	case MM_TIER_HINT_PREFETCH:
+		ret = backend->prefetch_range(req->mm, req->start, req->len,
+					      req->target_nid);
+		break;
+	case MM_TIER_HINT_PROMOTE:
+		ret = backend->promote_range(req->mm, req->start, req->len,
+					     req->target_nid);
+		break;
+	case MM_TIER_HINT_DEMOTE:
+		ret = backend->demote_range(req->mm, req->start, req->len,
+					    req->target_nid);
+		break;
+	case MM_TIER_HINT_RELEASE:
+		ret = backend->release_range(req->mm, req->start, req->len);
+		break;
+	default:
+		ret = -EOPNOTSUPP;
+		break;
+	}
+
+	if (ret >= 0) {
+		req->pages_moved = ret;
+		if (ret == 0 && req->pages_requested > 0)
+			atomic_set(&req->state, HBF_REQ_PARTIAL_SUCCESS);
+		else if (ret >= req->pages_requested)
+			atomic_set(&req->state, HBF_REQ_FULL_SUCCESS);
+		else
+			atomic_set(&req->state, HBF_REQ_PARTIAL_SUCCESS);
+	} else {
+		atomic_set(&req->state, HBF_REQ_BACKEND_FAILURE);
+		req->pages_failed = req->pages_requested;
+	}
+
+out:
+	req->complete_ns = ktime_get_ns();
+	trace_hbf_hint_complete(req->request_id, atomic_read(&req->state),
+				req->pages_moved, req->pages_failed,
+				req->complete_ns - req->start_ns,
+				req->start_ns - req->submit_ns);
+}
+
+static void hbf_do_work(struct work_struct *work)
+{
+	struct hbf_request *req = NULL;
+	unsigned long flags;
+
+	spin_lock_irqsave(&hbf_queue_lock, flags);
+	if (!list_empty(&hbf_queue)) {
+		req = list_first_entry(&hbf_queue, struct hbf_request,
+				       queue_node);
+		list_del_init(&req->queue_node);
+	}
+	spin_unlock_irqrestore(&hbf_queue_lock, flags);
+
+	if (req) {
+		hbf_request_get(req);
+		hbf_execute_request(req);
+		hbf_del_from_table(req);
+		atomic_dec(&hbf_inflight);
+		hbf_request_put(req);
+	}
+}
+
+int hbf_submit(struct hbf_request *req)
+{
+	unsigned long flags;
+	int ret;
+
+	trace_hbf_hint_submit(req->request_id, current->pid,
+			      current->tgid, req->op, req->start,
+			      req->len, req->target_nid);
+
+	ret = hbf_validate(req);
+	if (ret) {
+		atomic_set(&req->state, HBF_REQ_REJECTED);
+		trace_hbf_hint_reject(req->request_id, HBF_REJECT_INVALID_RANGE);
+		return ret;
+	}
+
+	atomic_set(&req->state, HBF_REQ_VALIDATED);
+
+	if (atomic_read(&hbf_inflight) >= HBF_MAX_INFLIGHT_GLOBAL) {
+		atomic_set(&req->state, HBF_REQ_REJECTED);
+		trace_hbf_queue_full(req->request_id,
+				     atomic_read(&hbf_inflight));
+		return -EAGAIN;
+	}
+
+	atomic_set(&req->state, HBF_REQ_ADMITTED);
+
+	hbf_add_to_table(req);
+
+	spin_lock_irqsave(&hbf_queue_lock, flags);
+	list_add_tail(&req->queue_node, &hbf_queue);
+	spin_unlock_irqrestore(&hbf_queue_lock, flags);
+
+	atomic_set(&req->state, HBF_REQ_QUEUED);
+	atomic_inc(&hbf_inflight);
+
+	trace_hbf_hint_queue(req->request_id, current->pid, current->tgid,
+			     req->op, req->start, req->len, req->target_nid);
+
+	schedule_work(&hbf_worker);
+
+	return 0;
+}
+
+int hbf_query(u64 request_id, struct hbf_request **out)
+{
+	struct hbf_request *req;
+	unsigned long flags;
+	int ret = -ENOENT;
+
+	spin_lock_irqsave(&hbf_request_lock, flags);
+	hash_for_each_possible(hbf_request_table, req, hlist_node, request_id) {
+		if (req->request_id == request_id) {
+			hbf_request_get(req);
+			*out = req;
+			ret = 0;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&hbf_request_lock, flags);
+
+	return ret;
+}
+
+int hbf_cancel(u64 request_id)
+{
+	struct hbf_request *req;
+	unsigned long flags;
+	int ret = -ENOENT;
+
+	spin_lock_irqsave(&hbf_request_lock, flags);
+	hash_for_each_possible(hbf_request_table, req, hlist_node, request_id) {
+		if (req->request_id == request_id) {
+			int state = atomic_read(&req->state);
+
+			if (state == HBF_REQ_QUEUED) {
+				list_del_init(&req->queue_node);
+				atomic_set(&req->state, HBF_REQ_CANCELLED);
+				hash_del(&req->hlist_node);
+				atomic_dec(&hbf_inflight);
+				trace_hbf_hint_cancel(request_id);
+				hbf_request_put(req);
+				ret = 0;
+			} else if (state >= HBF_REQ_RUNNING &&
+				   state < HBF_REQ_CANCELLED) {
+				atomic_set(&req->state, HBF_REQ_CANCELLED);
+				trace_hbf_hint_cancel(request_id);
+				ret = 0;
+			}
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&hbf_request_lock, flags);
+
+	return ret;
+}
+
+void hbf_release_mm(struct mm_struct *mm)
+{
+	struct hbf_request *req;
+	unsigned long flags;
+	int bkt;
+
+	spin_lock_irqsave(&hbf_request_lock, flags);
+	hash_for_each(hbf_request_table, bkt, req, hlist_node) {
+		if (req->mm == mm) {
+			int state = atomic_read(&req->state);
+
+			if (state == HBF_REQ_QUEUED) {
+				list_del_init(&req->queue_node);
+				atomic_dec(&hbf_inflight);
+			}
+
+			if (state < HBF_REQ_CANCELLED) {
+				atomic_set(&req->state, HBF_REQ_CANCELLED);
+				trace_hbf_hint_cancel(req->request_id);
+			}
+		}
+	}
+	spin_unlock_irqrestore(&hbf_request_lock, flags);
+}
+
+int hbf_init_request_table(void)
+{
+	hash_init(hbf_request_table);
+	spin_lock_init(&hbf_queue_lock);
+	INIT_WORK(&hbf_worker, hbf_do_work);
+	return 0;
+}
+
+void hbf_exit_request_table(void)
+{
+	struct hbf_request *req;
+	unsigned long flags;
+	int bkt;
+
+	cancel_work_sync(&hbf_worker);
+
+	spin_lock_irqsave(&hbf_request_lock, flags);
+	hash_for_each(hbf_request_table, bkt, req, hlist_node) {
+		hash_del(&req->hlist_node);
+		atomic_set(&req->state, HBF_REQ_CANCELLED);
+		hbf_request_put(req);
+	}
+	spin_unlock_irqrestore(&hbf_request_lock, flags);
+}
