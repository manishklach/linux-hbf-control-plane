diff --git a/mm/hbf/hbf_ioctl.c b/mm/hbf/hbf_ioctl.c
new file mode 100644
index 000000000..c2b86c087
--- /dev/null
+++ b/mm/hbf/hbf_ioctl.c
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/fs.h>
+#include <linux/uaccess.h>
+#include <linux/miscdevice.h>
+#include <linux/sched/mm.h>
+#include <linux/err.h>
+#include <linux/nodemask.h>
+#include <uapi/linux/hbf.h>
+#include "hbf_types.h"
+#include "hbf_ioctl.h"
+#include "hbf_ioctl.h"
+#include "hbf_request.h"
+#include "hbf_backend.h"
+
+static long hbf_ioctl_submit(struct file *file, unsigned long arg)
+{
+	struct hbf_user_hint uapi;
+	struct mm_tier_range_hint hint;
+	struct hbf_request *req;
+	u64 request_id;
+	int ret;
+
+	if (copy_from_user(&uapi, (void __user *)arg, sizeof(uapi)))
+		return -EFAULT;
+
+	if (uapi.version != 1)
+		return -EINVAL;
+
+	hint.start = uapi.start;
+	hint.len = uapi.len;
+	hint.target_nid = uapi.target_nid;
+	hint.deadline_ns = uapi.deadline_ns;
+	hint.cookie = uapi.user_tag;
+
+	switch (uapi.op) {
+	case HBF_HINT_PREFETCH:
+		hint.op = MM_TIER_HINT_PREFETCH;
+		break;
+	case HBF_HINT_PROMOTE:
+		hint.op = MM_TIER_HINT_PROMOTE;
+		break;
+	case HBF_HINT_DEMOTE:
+		hint.op = MM_TIER_HINT_DEMOTE;
+		break;
+	case HBF_HINT_RELEASE:
+		hint.op = MM_TIER_HINT_RELEASE;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	req = hbf_request_alloc(current->mm, &hint, uapi.user_tag);
+	if (IS_ERR(req))
+		return PTR_ERR(req);
+
+	ret = hbf_submit(req);
+	if (ret) {
+		hbf_request_put(req);
+		return ret;
+	}
+
+	request_id = req->request_id;
+	hbf_request_put(req);
+
+	if (copy_to_user((void __user *)arg, &request_id, sizeof(request_id)))
+		return -EFAULT;
+
+	return 0;
+}
+
+static long hbf_ioctl_query(struct file *file, unsigned long arg)
+{
+	struct hbf_query_result result;
+	struct hbf_request *req;
+	int ret;
+
+	if (copy_from_user(&result, (void __user *)arg, sizeof(result)))
+		return -EFAULT;
+
+	ret = hbf_query(result.request_id, &req);
+	if (ret)
+		return ret;
+
+	result.state = atomic_read(&req->state);
+	result.submit_ns = req->submit_ns;
+	result.start_ns = req->start_ns;
+	result.complete_ns = req->complete_ns;
+	result.pages_requested = req->pages_requested;
+	result.pages_processed = req->pages_processed;
+	result.pages_moved = req->pages_moved;
+	result.pages_failed = req->pages_failed;
+
+	hbf_request_put(req);
+
+	if (copy_to_user((void __user *)arg, &result, sizeof(result)))
+		return -EFAULT;
+
+	return 0;
+}
+
+static long hbf_ioctl_cancel(struct file *file, unsigned long arg)
+{
+	u64 request_id;
+
+	if (copy_from_user(&request_id, (void __user *)arg, sizeof(request_id)))
+		return -EFAULT;
+
+	return hbf_cancel(request_id);
+}
+
+static long hbf_ioctl_caps(struct file *file, unsigned long arg)
+{
+	struct hbf_caps caps = {
+		.max_request_bytes = HBF_MAX_BYTES_PER_REQUEST,
+		.max_inflight = HBF_MAX_INFLIGHT_GLOBAL,
+		.supported_ops = 0x0f,
+		.max_target_nodes = nr_node_ids,
+	};
+
+	if (copy_to_user((void __user *)arg, &caps, sizeof(caps)))
+		return -EFAULT;
+
+	return 0;
+}
+
+long hbf_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	switch (cmd) {
+	case HBF_IOC_SUBMIT:
+		return hbf_ioctl_submit(file, arg);
+	case HBF_IOC_QUERY:
+		return hbf_ioctl_query(file, arg);
+	case HBF_IOC_CANCEL:
+		return hbf_ioctl_cancel(file, arg);
+	case HBF_IOC_CAPS:
+		return hbf_ioctl_caps(file, arg);
+	default:
+		return -ENOTTY;
+	}
+}
