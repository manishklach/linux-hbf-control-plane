diff --git a/tools/testing/selftests/hbf/hbf_hint_test.c b/tools/testing/selftests/hbf/hbf_hint_test.c
new file mode 100644
index 000000000000..dddddddddddd
--- /dev/null
+++ b/tools/testing/selftests/hbf/hbf_hint_test.c
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/hbf.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+int main(void)
+{
+	struct hbf_user_hint hint = {
+		.version = HBF_UAPI_VERSION,
+		.op = HBF_HINT_PREFETCH,
+		.flags = HBF_HINT_F_ASYNC | HBF_HINT_F_READ_MOSTLY,
+		.object_id = 1,
+		.object_class = HBF_OBJECT_KV_CACHE,
+		.target_node = -1,
+	};
+	void *buf;
+	int fd, ret;
+
+	buf = aligned_alloc(4096, 4096 * 16);
+	if (!buf) {
+		perror("aligned_alloc");
+		return 1;
+	}
+
+	memset(buf, 0, 4096 * 16);
+	hint.va = (unsigned long)buf;
+	hint.len = 4096 * 16;
+
+	fd = open("/dev/hbfctl", O_RDONLY);
+	if (fd < 0) {
+		if (errno == ENOENT) {
+			printf("SKIP: /dev/hbfctl not present\n");
+			free(buf);
+			return 4;
+		}
+		perror("open");
+		free(buf);
+		return 1;
+	}
+
+	ret = ioctl(fd, HBF_IOC_SUBMIT_HINT, &hint);
+	if (ret < 0 && errno == ENODEV) {
+		printf("OK: no HBF devices registered\n");
+		close(fd);
+		free(buf);
+		return 0;
+	}
+
+	if (ret < 0) {
+		perror("ioctl");
+		close(fd);
+		free(buf);
+		return 1;
+	}
+
+	printf("OK: HBF hint accepted\n");
+	close(fd);
+	free(buf);
+	return 0;
+}
