diff --git a/mm/hbf.c b/mm/hbf.c
new file mode 100644
index 0000000..e05d2bd
--- /dev/null
+++ b/mm/hbf.c
@@ -0,0 +1,124 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/miscdevice.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/sched/mm.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <uapi/linux/hbf.h>
+
+static int hbf_validate_vma_range(struct mm_struct *mm,
+				 unsigned long start,
+				 unsigned long len)
+{
+	struct vm_area_struct *vma;
+	unsigned long end;
+
+	if (!mm || !len)
+		return -EINVAL;
+
+	end = start + len;
+	if (end < start)
+		return -EINVAL;
+
+	mmap_read_lock(mm);
+	vma = find_vma(mm, start);
+	if (!vma || start < vma->vm_start || end > vma->vm_end) {
+		mmap_read_unlock(mm);
+		return -EFAULT;
+	}
+	mmap_read_unlock(mm);
+
+	return 0;
+}
+
+int hbf_hint_range(struct mm_struct *mm, unsigned long start,
+		   unsigned long len,
+		   const struct hbf_hint_range *hint)
+{
+	int ret;
+
+	if (!hint)
+		return -EINVAL;
+
+	ret = hbf_validate_vma_range(mm, start, len);
+	if (ret)
+		return ret;
+
+	switch (hint->op) {
+	case HBF_HINT_PREFETCH:
+	case HBF_HINT_PROMOTE:
+	case HBF_HINT_DEMOTE:
+	case HBF_HINT_RELEASE:
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/*
+	 * TODO: Connect prefetch / promote / demote decisions to core mm
+	 * machinery rather than implementing driver-first policy here.
+	 *
+	 * Candidate integration points:
+	 *   - mm/migrate.c
+	 *   - mm/memory-tiers.c
+	 *   - mm/mempolicy.c
+	 *   - drivers/cxl/core/
+	 *   - drivers/cxl/mem.c
+	 *   - drivers/cxl/region.c
+	 *   - drivers/dax/kmem.c
+	 */
+	return -EOPNOTSUPP;
+}
+EXPORT_SYMBOL_GPL(hbf_hint_range);
+
+static long hbf_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct hbf_hint_range hint;
+
+	if (cmd != HBF_IOC_HINT)
+		return -ENOTTY;
+
+	if (copy_from_user(&hint, (void __user *)arg, sizeof(hint)))
+		return -EFAULT;
+
+	if (hint.version != HBF_UAPI_VERSION)
+		return -EINVAL;
+
+	if (!current->mm)
+		return -EOPNOTSUPP;
+
+	return hbf_hint_range(current->mm, hint.start, hint.len, &hint);
+}
+
+static const struct file_operations hbf_fops = {
+	.owner		= THIS_MODULE,
+	.unlocked_ioctl	= hbf_ioctl,
+	.compat_ioctl	= compat_ptr_ioctl,
+	.llseek		= no_llseek,
+};
+
+static struct miscdevice hbf_miscdev = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name = "hbfctl",
+	.fops = &hbf_fops,
+	.mode = 0600,
+};
+
+static int __init hbf_init(void)
+{
+	return misc_register(&hbf_miscdev);
+}
+module_init(hbf_init);
+
+static void __exit hbf_exit(void)
+{
+	misc_deregister(&hbf_miscdev);
+}
+module_exit(hbf_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Experimental HBF-like memory tier hint control plane");
\ No newline at end of file
diff --git a/samples/hbf/hbfctl-demo.c b/samples/hbf/hbfctl-demo.c
new file mode 100644
index 0000000..8f6f9f1
--- /dev/null
+++ b/samples/hbf/hbfctl-demo.c
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/hbf.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage:\n"
+		"  %s --prefetch 0xADDR LEN\n"
+		"  %s --promote  0xADDR LEN\n"
+		"  %s --demote   0xADDR LEN\n"
+		"  %s --release  0xADDR LEN\n",
+		prog, prog, prog, prog);
+}
+
+static int parse_u64(const char *arg, uint64_t *out)
+{
+	char *end = NULL;
+	unsigned long long value;
+
+	errno = 0;
+	value = strtoull(arg, &end, 0);
+	if (errno || !end || *end != '\0')
+		return -1;
+
+	*out = value;
+	return 0;
+}
+
+static uint32_t parse_op(const char *arg)
+{
+	if (!strcmp(arg, "--prefetch"))
+		return HBF_HINT_PREFETCH;
+	if (!strcmp(arg, "--promote"))
+		return HBF_HINT_PROMOTE;
+	if (!strcmp(arg, "--demote"))
+		return HBF_HINT_DEMOTE;
+	if (!strcmp(arg, "--release"))
+		return HBF_HINT_RELEASE;
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
+	struct hbf_hint_range hint = {
+		.version = HBF_UAPI_VERSION,
+		.target_nid = -1,
+	};
+	uint64_t start;
+	uint64_t len;
+	int fd;
+
+	if (argc != 4) {
+		usage(argv[0]);
+		return 2;
+	}
+
+	hint.op = parse_op(argv[1]);
+	if (!hint.op) {
+		usage(argv[0]);
+		return 2;
+	}
+
+	if (parse_u64(argv[2], &start) || parse_u64(argv[3], &len)) {
+		fprintf(stderr, "Invalid address or length.\n");
+		return 2;
+	}
+
+	hint.start = start;
+	hint.len = len;
+
+	fd = open("/dev/hbfctl", O_RDWR);
+	if (fd < 0) {
+		if (errno == ENOENT) {
+			fprintf(stderr,
+				"/dev/hbfctl not found. This is expected unless the RFC frontend is enabled.\n");
+			return 0;
+		}
+		perror("open");
+		return 1;
+	}
+
+	if (ioctl(fd, HBF_IOC_HINT, &hint) < 0) {
+		perror("ioctl(HBF_IOC_HINT)");
+		close(fd);
+		return 1;
+	}
+
+	printf("submitted hint op=%u start=0x%llx len=%llu\n",
+	       hint.op,
+	       (unsigned long long)hint.start,
+	       (unsigned long long)hint.len);
+	close(fd);
+	return 0;
+}
\ No newline at end of file
diff --git a/tools/testing/selftests/mm/hbf_hint_abi.c b/tools/testing/selftests/mm/hbf_hint_abi.c
new file mode 100644
index 0000000..9ebb920
--- /dev/null
+++ b/tools/testing/selftests/mm/hbf_hint_abi.c
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/hbf.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+int main(void)
+{
+	struct hbf_hint_range hint = {
+		.version = HBF_UAPI_VERSION,
+		.op = HBF_HINT_PREFETCH,
+		.start = 0x1000,
+		.len = 0x1000,
+		.target_nid = -1,
+	};
+	int fd;
+
+	fd = open("/dev/hbfctl", O_RDWR);
+	if (fd < 0) {
+		if (errno == ENOENT) {
+			printf("SKIP: /dev/hbfctl not present\n");
+			return 4;
+		}
+		perror("open");
+		return 1;
+	}
+
+	if (ioctl(fd, HBF_IOC_HINT, &hint) < 0) {
+		if (errno == EOPNOTSUPP) {
+			printf("OK: skeleton returned EOPNOTSUPP\n");
+			close(fd);
+			return 0;
+		}
+		perror("ioctl");
+		close(fd);
+		return 1;
+	}
+
+	close(fd);
+	puts("OK: hint ioctl accepted");
+	return 0;
+}
\ No newline at end of file
