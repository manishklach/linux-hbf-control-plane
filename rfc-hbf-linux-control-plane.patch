diff --git a/include/uapi/linux/hbf.h b/include/uapi/linux/hbf.h
new file mode 100644
index 000000000000..777777777777
--- /dev/null
+++ b/include/uapi/linux/hbf.h
@@ -0,0 +1,92 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_LINUX_HBF_H
+#define _UAPI_LINUX_HBF_H
+
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+#define HBF_IOCTL_MAGIC		'H'
+
+/*
+ * HBF object classes describe what the runtime is hinting about.  The kernel
+ * must treat these as advisory.  They are not security labels and do not imply
+ * ownership of the virtual address range.
+ */
+enum hbf_object_class {
+	HBF_OBJECT_UNKNOWN	= 0,
+	HBF_OBJECT_KV_CACHE	= 1,
+	HBF_OBJECT_MODEL_WEIGHT	= 2,
+	HBF_OBJECT_EMBEDDING	= 3,
+	HBF_OBJECT_CONTEXT	= 4,
+	HBF_OBJECT_SCRATCH	= 5,
+};
+
+enum hbf_hint_op {
+	HBF_HINT_PREFETCH	= 1, /* stage before demand */
+	HBF_HINT_PROMOTE	= 2, /* prefer faster tier */
+	HBF_HINT_DEMOTE		= 3, /* prefer HBF/warm tier */
+	HBF_HINT_PIN_WARM	= 4, /* keep in HBF if possible */
+	HBF_HINT_RELEASE	= 5, /* object no longer useful */
+};
+
+#define HBF_HINT_F_NOWAIT		(1ULL << 0)
+#define HBF_HINT_F_ASYNC		(1ULL << 1)
+#define HBF_HINT_F_WRITE_INTENT		(1ULL << 2)
+#define HBF_HINT_F_READ_MOSTLY		(1ULL << 3)
+
+/*
+ * Runtime placement hint.
+ *
+ * va/len identify the userspace virtual range.  object_id is runtime-defined
+ * and is surfaced in tracepoints so runtimes can correlate kernel behavior with
+ * token/KV/context objects.
+ *
+ * deadline_ns is relative CLOCK_MONOTONIC time in nanoseconds.  A value of 0
+ * means there is no explicit deadline.
+ *
+ * target_node is optional.  -1 means "kernel chooses".
+ */
+struct hbf_user_hint {
+	__u32 version;
+	__u32 op;
+	__u64 flags;
+
+	__u64 va;
+	__u64 len;
+	__u64 object_id;
+
+	__u32 object_class;
+	__s32 target_node;
+
+	__u64 deadline_ns;
+	__u64 expected_reuse_ns;
+
+	__u64 reserved[8];
+};
+
+#define HBF_UAPI_VERSION	1
+
+#define HBF_IOC_SUBMIT_HINT	_IOW(HBF_IOCTL_MAGIC, 0x01, struct hbf_user_hint)
+
+#endif /* _UAPI_LINUX_HBF_H */

diff --git a/include/linux/hbf.h b/include/linux/hbf.h
new file mode 100644
index 000000000000..888888888888
--- /dev/null
+++ b/include/linux/hbf.h
@@ -0,0 +1,77 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_HBF_H
+#define _LINUX_HBF_H
+
+#include <linux/device.h>
+#include <linux/list.h>
+#include <linux/mutex.h>
+#include <linux/types.h>
+#include <uapi/linux/hbf.h>
+
+struct hbf_device;
+
+/**
+ * struct hbf_dev_ops - operations supplied by an HBF hardware driver
+ * @submit_hint: consume a runtime hint; may schedule DMA/prefetch/migration
+ *
+ * The callback is advisory and may return:
+ *   0          hint accepted
+ *   -EOPNOTSUPP unsupported hint
+ *   -EBUSY     no capacity/queue space
+ *   <0         other failure
+ */
+struct hbf_dev_ops {
+	int (*submit_hint)(struct hbf_device *hdev,
+			   const struct hbf_user_hint *hint);
+};
+
+/**
+ * struct hbf_dev_desc - HBF device registration descriptor
+ * @parent: physical parent device
+ * @name: user-visible device name
+ * @nid: NUMA node if known, otherwise NUMA_NO_NODE
+ * @capacity_bytes: usable HBF capacity
+ * @read_bw_bytes_per_sec: approximate read bandwidth
+ * @write_bw_bytes_per_sec: approximate write bandwidth
+ * @read_latency_ns: approximate media/controller read latency
+ * @ops: device operations
+ * @driver_data: opaque driver data
+ */
+struct hbf_dev_desc {
+	struct device *parent;
+	const char *name;
+	int nid;
+	u64 capacity_bytes;
+	u64 read_bw_bytes_per_sec;
+	u64 write_bw_bytes_per_sec;
+	u64 read_latency_ns;
+	const struct hbf_dev_ops *ops;
+	void *driver_data;
+};
+
+struct hbf_device {
+	struct device dev;
+	struct list_head node;
+	struct mutex lock;
+
+	int id;
+	int nid;
+	u64 capacity_bytes;
+	u64 read_bw_bytes_per_sec;
+	u64 write_bw_bytes_per_sec;
+	u64 read_latency_ns;
+
+	const struct hbf_dev_ops *ops;
+	void *driver_data;
+};
+
+#define to_hbf_device(_dev) container_of(_dev, struct hbf_device, dev)
+
+#if IS_ENABLED(CONFIG_HBF)
+struct hbf_device *hbf_register_device(const struct hbf_dev_desc *desc);
+void hbf_unregister_device(struct hbf_device *hdev);
+#else
+static inline struct hbf_device *hbf_register_device(const struct hbf_dev_desc *desc)
+{
+	return ERR_PTR(-EOPNOTSUPP);
+}
+static inline void hbf_unregister_device(struct hbf_device *hdev) {}
+#endif
+
+#endif /* _LINUX_HBF_H */

diff --git a/drivers/memory/hbf/core.c b/drivers/memory/hbf/core.c
new file mode 100644
index 000000000000..999999999999
--- /dev/null
+++ b/drivers/memory/hbf/core.c
@@ -0,0 +1,328 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * High Bandwidth Flash (HBF) control plane
+ *
+ * This core intentionally avoids binding to a concrete HBF transport.  HBF
+ * hardware may appear as CXL-attached memory, a PCIe device, an accelerator-
+ * local tier, or another platform-specific device.  The role of this file is
+ * to provide a common registration and userspace hint surface.
+ */
+
+#include <linux/anon_inodes.h>
+#include <linux/atomic.h>
+#include <linux/cdev.h>
+#include <linux/class.h>
+#include <linux/err.h>
+#include <linux/fs.h>
+#include <linux/hbf.h>
+#include <linux/idr.h>
+#include <linux/init.h>
+#include <linux/list.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+#include "trace.h"
+
+static DEFINE_IDA(hbf_ida);
+static DEFINE_MUTEX(hbf_devices_lock);
+static LIST_HEAD(hbf_devices);
+
+static struct class *hbf_class;
+
+static ssize_t capacity_bytes_show(struct device *dev,
+				   struct device_attribute *attr, char *buf)
+{
+	struct hbf_device *hdev = to_hbf_device(dev);
+
+	return sysfs_emit(buf, "%llu\n", hdev->capacity_bytes);
+}
+static DEVICE_ATTR_RO(capacity_bytes);
+
+static ssize_t numa_node_show(struct device *dev,
+			      struct device_attribute *attr, char *buf)
+{
+	struct hbf_device *hdev = to_hbf_device(dev);
+
+	return sysfs_emit(buf, "%d\n", hdev->nid);
+}
+static DEVICE_ATTR_RO(numa_node);
+
+static ssize_t read_bandwidth_bytes_per_sec_show(struct device *dev,
+						 struct device_attribute *attr,
+						 char *buf)
+{
+	struct hbf_device *hdev = to_hbf_device(dev);
+
+	return sysfs_emit(buf, "%llu\n", hdev->read_bw_bytes_per_sec);
+}
+static DEVICE_ATTR_RO(read_bandwidth_bytes_per_sec);
+
+static ssize_t write_bandwidth_bytes_per_sec_show(struct device *dev,
+						  struct device_attribute *attr,
+						  char *buf)
+{
+	struct hbf_device *hdev = to_hbf_device(dev);
+
+	return sysfs_emit(buf, "%llu\n", hdev->write_bw_bytes_per_sec);
+}
+static DEVICE_ATTR_RO(write_bandwidth_bytes_per_sec);
+
+static ssize_t read_latency_ns_show(struct device *dev,
+				    struct device_attribute *attr, char *buf)
+{
+	struct hbf_device *hdev = to_hbf_device(dev);
+
+	return sysfs_emit(buf, "%llu\n", hdev->read_latency_ns);
+}
+static DEVICE_ATTR_RO(read_latency_ns);
+
+static struct attribute *hbf_dev_attrs[] = {
+	&dev_attr_capacity_bytes.attr,
+	&dev_attr_numa_node.attr,
+	&dev_attr_read_bandwidth_bytes_per_sec.attr,
+	&dev_attr_write_bandwidth_bytes_per_sec.attr,
+	&dev_attr_read_latency_ns.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(hbf_dev);
+
+static void hbf_device_release(struct device *dev)
+{
+	struct hbf_device *hdev = to_hbf_device(dev);
+
+	kfree(hdev);
+}
+
+static bool hbf_valid_hint(const struct hbf_user_hint *hint)
+{
+	if (hint->version != HBF_UAPI_VERSION)
+		return false;
+
+	if (!hint->len)
+		return false;
+
+	if (hint->va + hint->len < hint->va)
+		return false;
+
+	switch (hint->op) {
+	case HBF_HINT_PREFETCH:
+	case HBF_HINT_PROMOTE:
+	case HBF_HINT_DEMOTE:
+	case HBF_HINT_PIN_WARM:
+	case HBF_HINT_RELEASE:
+		break;
+	default:
+		return false;
+	}
+
+	switch (hint->object_class) {
+	case HBF_OBJECT_UNKNOWN:
+	case HBF_OBJECT_KV_CACHE:
+	case HBF_OBJECT_MODEL_WEIGHT:
+	case HBF_OBJECT_EMBEDDING:
+	case HBF_OBJECT_CONTEXT:
+	case HBF_OBJECT_SCRATCH:
+		break;
+	default:
+		return false;
+	}
+
+	return true;
+}
+
+static int hbf_submit_hint_to_device(struct hbf_device *hdev,
+				     const struct hbf_user_hint *hint)
+{
+	int ret = -EOPNOTSUPP;
+
+	mutex_lock(&hdev->lock);
+	if (hdev->ops && hdev->ops->submit_hint)
+		ret = hdev->ops->submit_hint(hdev, hint);
+	mutex_unlock(&hdev->lock);
+
+	return ret;
+}
+
+/*
+ * First policy is deliberately simple:
+ *   - if userspace provides target_node, prefer matching HBF devices
+ *   - otherwise broadcast to the first registered device
+ *
+ * A future policy engine should consider memory tiers, DAMON hotness,
+ * NUMA locality, CXL region bandwidth, queue depth, and accelerator affinity.
+ */
+static int hbf_dispatch_hint(const struct hbf_user_hint *hint)
+{
+	struct hbf_device *hdev, *fallback = NULL;
+	int ret = -ENODEV;
+
+	mutex_lock(&hbf_devices_lock);
+	list_for_each_entry(hdev, &hbf_devices, node) {
+		if (!fallback)
+			fallback = hdev;
+
+		if (hint->target_node >= 0 && hdev->nid == hint->target_node) {
+			get_device(&hdev->dev);
+			mutex_unlock(&hbf_devices_lock);
+			ret = hbf_submit_hint_to_device(hdev, hint);
+			put_device(&hdev->dev);
+			return ret;
+		}
+	}
+
+	if (fallback)
+		get_device(&fallback->dev);
+	mutex_unlock(&hbf_devices_lock);
+
+	if (fallback) {
+		ret = hbf_submit_hint_to_device(fallback, hint);
+		put_device(&fallback->dev);
+	}
+
+	return ret;
+}
+
+static long hbf_ctl_ioctl(struct file *file, unsigned int cmd,
+			  unsigned long arg)
+{
+	struct hbf_user_hint hint;
+	int ret;
+
+	switch (cmd) {
+	case HBF_IOC_SUBMIT_HINT:
+		if (copy_from_user(&hint, (void __user *)arg, sizeof(hint)))
+			return -EFAULT;
+
+		if (!hbf_valid_hint(&hint))
+			return -EINVAL;
+
+		trace_hbf_hint_submit(hint.object_id, hint.op,
+				      hint.object_class, hint.va, hint.len,
+				      hint.target_node, hint.flags);
+
+		ret = hbf_dispatch_hint(&hint);
+
+		trace_hbf_hint_complete(hint.object_id, hint.op, ret);
+
+		return ret;
+	default:
+		return -ENOTTY;
+	}
+}
+
+static const struct file_operations hbf_ctl_fops = {
+	.owner		= THIS_MODULE,
+	.unlocked_ioctl	= hbf_ctl_ioctl,
+	.compat_ioctl	= compat_ptr_ioctl,
+	.llseek		= no_llseek,
+};
+
+static struct miscdevice hbf_miscdev = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name = "hbfctl",
+	.fops = &hbf_ctl_fops,
+	.mode = 0600,
+};
+
+struct hbf_device *hbf_register_device(const struct hbf_dev_desc *desc)
+{
+	struct hbf_device *hdev;
+	int id, ret;
+
+	if (!desc || !desc->name || !desc->parent)
+		return ERR_PTR(-EINVAL);
+
+	id = ida_alloc(&hbf_ida, GFP_KERNEL);
+	if (id < 0)
+		return ERR_PTR(id);
+
+	hdev = kzalloc(sizeof(*hdev), GFP_KERNEL);
+	if (!hdev) {
+		ret = -ENOMEM;
+		goto err_ida;
+	}
+
+	hdev->id = id;
+	hdev->nid = desc->nid;
+	hdev->capacity_bytes = desc->capacity_bytes;
+	hdev->read_bw_bytes_per_sec = desc->read_bw_bytes_per_sec;
+	hdev->write_bw_bytes_per_sec = desc->write_bw_bytes_per_sec;
+	hdev->read_latency_ns = desc->read_latency_ns;
+	hdev->ops = desc->ops;
+	hdev->driver_data = desc->driver_data;
+	mutex_init(&hdev->lock);
+	INIT_LIST_HEAD(&hdev->node);
+
+	device_initialize(&hdev->dev);
+	hdev->dev.class = hbf_class;
+	hdev->dev.parent = desc->parent;
+	hdev->dev.release = hbf_device_release;
+	dev_set_name(&hdev->dev, "hbf%d", id);
+
+	ret = device_add(&hdev->dev);
+	if (ret)
+		goto err_put;
+
+	mutex_lock(&hbf_devices_lock);
+	list_add_tail(&hdev->node, &hbf_devices);
+	mutex_unlock(&hbf_devices_lock);
+
+	dev_info(&hdev->dev, "registered HBF device '%s'\n", desc->name);
+
+	return hdev;
+
+err_put:
+	put_device(&hdev->dev);
+err_ida:
+	ida_free(&hbf_ida, id);
+	return ERR_PTR(ret);
+}
+EXPORT_SYMBOL_GPL(hbf_register_device);
+
+void hbf_unregister_device(struct hbf_device *hdev)
+{
+	if (!hdev)
+		return;
+
+	mutex_lock(&hbf_devices_lock);
+	list_del_init(&hdev->node);
+	mutex_unlock(&hbf_devices_lock);
+
+	device_unregister(&hdev->dev);
+	ida_free(&hbf_ida, hdev->id);
+}
+EXPORT_SYMBOL_GPL(hbf_unregister_device);
+
+static int __init hbf_init(void)
+{
+	int ret;
+
+	hbf_class = class_create("hbf");
+	if (IS_ERR(hbf_class))
+		return PTR_ERR(hbf_class);
+
+	hbf_class->dev_groups = hbf_dev_groups;
+
+	ret = misc_register(&hbf_miscdev);
+	if (ret)
+		goto err_class;
+
+	pr_info("hbf: High Bandwidth Flash control plane initialized\n");
+	return 0;
+
+err_class:
+	class_destroy(hbf_class);
+	return ret;
+}
+module_init(hbf_init);
+
+static void __exit hbf_exit(void)
+{
+	misc_deregister(&hbf_miscdev);
+	class_destroy(hbf_class);
+	ida_destroy(&hbf_ida);
+}
+module_exit(hbf_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("Manish KL");
+MODULE_DESCRIPTION("High Bandwidth Flash control plane");

diff --git a/drivers/memory/hbf/trace.h b/drivers/memory/hbf/trace.h
new file mode 100644
index 000000000000..aaaaaaaaaaaa
--- /dev/null
+++ b/drivers/memory/hbf/trace.h
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM hbf
+
+#if !defined(_HBF_TRACE_H) || defined(TRACE_HEADER_MULTI_READ)
+#define _HBF_TRACE_H
+
+#include <linux/tracepoint.h>
+
+TRACE_EVENT(hbf_hint_submit,
+	TP_PROTO(u64 object_id, u32 op, u32 object_class, u64 va, u64 len,
+		 s32 target_node, u64 flags),
+	TP_ARGS(object_id, op, object_class, va, len, target_node, flags),
+	TP_STRUCT__entry(
+		__field(u64, object_id)
+		__field(u32, op)
+		__field(u32, object_class)
+		__field(u64, va)
+		__field(u64, len)
+		__field(s32, target_node)
+		__field(u64, flags)
+	),
+	TP_fast_assign(
+		__entry->object_id = object_id;
+		__entry->op = op;
+		__entry->object_class = object_class;
+		__entry->va = va;
+		__entry->len = len;
+		__entry->target_node = target_node;
+		__entry->flags = flags;
+	),
+	TP_printk("object_id=%llu op=%u class=%u va=0x%llx len=%llu target_node=%d flags=0x%llx",
+		  __entry->object_id, __entry->op, __entry->object_class,
+		  __entry->va, __entry->len, __entry->target_node,
+		  __entry->flags)
+);
+
+TRACE_EVENT(hbf_hint_complete,
+	TP_PROTO(u64 object_id, u32 op, int ret),
+	TP_ARGS(object_id, op, ret),
+	TP_STRUCT__entry(
+		__field(u64, object_id)
+		__field(u32, op)
+		__field(int, ret)
+	),
+	TP_fast_assign(
+		__entry->object_id = object_id;
+		__entry->op = op;
+		__entry->ret = ret;
+	),
+	TP_printk("object_id=%llu op=%u ret=%d",
+		  __entry->object_id, __entry->op, __entry->ret)
+);
+
+#endif /* _HBF_TRACE_H */
+
+#undef TRACE_INCLUDE_PATH
+#define TRACE_INCLUDE_PATH .
+#undef TRACE_INCLUDE_FILE
+#define TRACE_INCLUDE_FILE trace
+
+#include <trace/define_trace.h>

