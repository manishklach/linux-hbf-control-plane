+# SPDX-License-Identifier: GPL-2.0
+
+menuconfig HBF
+	tristate "High Bandwidth Flash (HBF) control plane"
+	depends on MMU
+	select SRCU
+	help
+	  Enable a generic kernel control plane for High Bandwidth Flash
+	  devices and tiers.
+
+	  HBF is expected to be a high-capacity, high-bandwidth NAND-based
+	  memory tier used by AI inference and other memory-capacity-bound
+	  workloads.  This option does not bind to a concrete HBF device.
+	  Instead, it provides:
+
+	    /dev/hbfctl
+	    /sys/class/hbf/
+	    an in-kernel registration API
+	    a userspace hint ABI for placement and prefetch
+
+	  Future CXL, PCIe, or platform HBF drivers can register devices with
+	  this core and consume runtime hints.
+
+	  If unsure, say N.
+
+if HBF
+
+source "drivers/memory/hbf/Kconfig.debug"
+
+endif
+
